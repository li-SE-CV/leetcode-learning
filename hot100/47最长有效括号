和前面的有效括号（栈）一样，只不过一个判断一个是计算有效长度（只限定在（），没有{}和[]）
栈存未匹配括号的下标，每当匹配成功，长度 = 当前下标 - 栈顶下标

s = "(()())"
stack=[-1]

i=0 '(' → [-1,0]
i=1 '(' → [-1,0,1]
i=2 ')' → [-1,0]   len=2-0=2
i=3 '(' → [-1,0,3]
i=4 ')' → [-1,0]   len=4-0=4
i=5 ')' → [-1]     len=5-(-1)=6
max_len=6

栈顶永远是：当前有效括号子串的左边界前一个位置，长度 = i - stack[-1]

class Solution:
    def longestValidParentheses(self, s: str) -> int:
        stack=[-1]##作为“起始边界”
        m=len(s)
        max_len=0
        for i in range(m):
            if s[i]=='(':
                stack.append(i)
            else:
                stack.pop()
                if not stack:  ##说明没有左括号可以匹配
                    stack.append(i)
                else:
                    max_len=max(max_len, i-stack[-1]) #栈顶是“最后一个未匹配的位置”

        return max_len
