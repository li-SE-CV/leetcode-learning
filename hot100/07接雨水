整体思路：每个位置能接的水 = min(左边最高, 右边最高) - 当前高度
1. 预处理左最大数组 pre
2. 预处理右最大数组 suf
3. 枚举每个位置，计算水量



用来双数列，代码很简单
class Solution(object):
    def trap(self, height):
        n=len(height)
        pre=[0]*n
        pre[0]=height[0]
        for i in range(1,n):
            pre[i]=max(pre[i-1],height[i])##从左到右，第 i 个位置左边（包括自己）的最高柱子
        
        suf=[0]*n
        suf[-1]=height[-1] #最后一个元素
        for i in range(n-2,-1,-1):
            suf[i]=max(suf[i+1],height[i])##从右到左，第 i 个位置右边（包括自己）的最高柱子
        ans=0

        for h,p,s in zip(height,pre,suf):
            ans+=min(p,s)-h
        return ans
